{
  "version": 2,
  "fontFamilies": [
    {
      "key": "site-sans",
      "label": "Archivo"
    }
  ],
  "pages": [
    {
      "key": "home",
      "path": "/",
      "label": "Homepage",
      "modules": [
        {
          "key": "hero",
          "type": "hero",
          "label": "Primary homepage banner",
          "canHide": false,
          "canReorder": false,
          "fields": [
            {
              "key": "eyebrow",
              "type": "text",
              "label": "Eyebrow",
              "localized": true,
              "required": true,
              "maxLength": 90
            },
            {
              "key": "title",
              "type": "text",
              "label": "Primary heading",
              "localized": true,
              "required": true,
              "maxLength": 120,
              "typography": {
                "fontFamilies": [
                  "site-sans"
                ],
                "fontWeights": [
                  500,
                  600,
                  700
                ],
                "fontSize": {
                  "min": 28,
                  "max": 72
                },
                "defaults": {
                  "fontFamily": "site-sans",
                  "fontWeight": 700,
                  "fontSizeDesktop": 64,
                  "fontSizeMobile": 40
                }
              }
            },
            {
              "key": "body",
              "type": "textarea",
              "label": "Banner description",
              "localized": true,
              "required": true,
              "maxLength": 360
            },
            {
              "key": "primary_label",
              "type": "text",
              "label": "Primary button",
              "localized": true,
              "required": true,
              "maxLength": 50
            },
            {
              "key": "secondary_label",
              "type": "text",
              "label": "Secondary button",
              "localized": true,
              "required": true,
              "maxLength": 50
            }
          ]
        },
        {
          "key": "faq",
          "type": "faq",
          "label": "Buyer questions",
          "canHide": false,
          "canReorder": false,
          "fields": [
            {
              "key": "items",
              "type": "repeat",
              "label": "Questions",
              "required": true,
              "maxItems": 20,
              "fields": [
                {
                  "key": "question",
                  "type": "text",
                  "label": "Question",
                  "localized": true,
                  "required": true,
                  "maxLength": 180
                },
                {
                  "key": "answer",
                  "type": "textarea",
                  "label": "Answer",
                  "localized": true,
                  "required": true,
                  "maxLength": 600
                }
              ]
            }
          ]
        },
        {
          "key": "seo",
          "type": "seo",
          "label": "Homepage SEO",
          "canHide": false,
          "canReorder": false,
          "fields": [
            {
              "key": "title",
              "type": "text",
              "label": "SEO title",
              "localized": true,
              "required": true,
              "maxLength": 70
            },
            {
              "key": "description",
              "type": "textarea",
              "label": "SEO description",
              "localized": true,
              "required": true,
              "maxLength": 170
            }
          ]
        }
      ]
    }
  ]
}
